<main class="container">
  <header class="site-header">
    <a class="site-title" href="<%= @site_base_path %>/">
      Saumitra's Blog
    </a>
  </header>

  <article class="post">
    <header class="post-header">
      <h1><%= @post.title %></h1>

      <time datetime="<%= @post.published_at.iso8601 %>">
        <%= @post.published_at.strftime("%B %-d, %Y") %>
      </time>
    </header>

    <div class="post-content">
      <%= @post.html.html_safe %>
    </div>
  </article>

  <nav class="post-navigation" aria-label="Article navigation">
    <a href="<%= @site_base_path %>/">
      &larr; All articles
    </a>
  </nav>
</main>