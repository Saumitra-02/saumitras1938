<main class="container">
  <header class="site-header">
    <a class="site-title" href="<%= @site_base_path %>/">
      Blog
    </a>
    <p class="site-description">
      Notes.
    </p>
  </header>

  <section aria-label="Blog posts">
    <h1>Writing</h1>

    <% if @posts.empty? %>
      <p>No articles published yet.</p>
    <% else %>
      <ul class="post-list">
        <% @posts.each do |post| %>
          <li class="post-item">
            <article>
              <h2>
                <a href="<%= @site_base_path %>/posts/<%= post.slug %>/">
                  <%= post.title %>
                </a>
              </h2>

              <time datetime="<%= post.published_at.iso8601 %>">
                <%= post.published_at.strftime("%b %-d, %Y") %>
              </time>
            </article>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
</main>